@page "/themeriver"
@rendermode InteractiveServer

<PageTitle>Theme River Chart</PageTitle>

<h1>Theme River Chart</h1>
<p>A theme river chart showing trends over time for multiple categories.</p>

<div class="chart-container">
    <EChart OptionRaw="@_option" style="width:100%;height:100%;" />
</div>

