@page "/tree"
@rendermode InteractiveServer

<PageTitle>Tree Chart</PageTitle>

<h1>Tree Chart</h1>
<p>A tree diagram showing a hierarchical organization.</p>

<div class="chart-container">
    <EChart OptionRaw="@_option" style="width:100%;height:100%;" />
</div>

@code {
    private string _option = @"{
        ""title"": { ""text"": ""File System"" },
        ""tooltip"": { ""trigger"": ""item"" },
        ""series"": [{
            ""type"": ""tree"",
            ""data"": [{
                ""name"": ""root"",
                ""children"": [
                    { ""name"": ""src"", ""children"": [
                        { ""name"": ""components"", ""children"": [
                            { ""name"": ""Header.tsx"" },
                            { ""name"": ""Footer.tsx"" },
                            { ""name"": ""Sidebar.tsx"" }
                        ]},
                        { ""name"": ""pages"", ""children"": [
                            { ""name"": ""Home.tsx"" },
                            { ""name"": ""About.tsx"" }
                        ]},
                        { ""name"": ""utils"", ""children"": [
                            { ""name"": ""helpers.ts"" },
                            { ""name"": ""api.ts"" }
                        ]}
                    ]},
                    { ""name"": ""public"", ""children"": [
                        { ""name"": ""index.html"" },
                        { ""name"": ""favicon.ico"" }
                    ]},
                    { ""name"": ""package.json"" }
                ]
            }],
            ""top"": ""5%"",
            ""left"": ""10%"",
            ""bottom"": ""5%"",
            ""right"": ""20%"",
            ""symbolSize"": 10,
            ""label"": { ""position"": ""left"", ""verticalAlign"": ""middle"", ""align"": ""right"", ""fontSize"": 12 },
            ""leaves"": { ""label"": { ""position"": ""right"", ""verticalAlign"": ""middle"", ""align"": ""left"" } },
            ""expandAndCollapse"": true,
            ""animationDuration"": 550,
            ""animationDurationUpdate"": 750
        }]
    }";
}
