@page "/gauge"
@rendermode InteractiveServer

<PageTitle>Gauge Chart</PageTitle>

<h1>Gauge Chart</h1>
<p>A gauge/meter chart showing a speed indicator.</p>

<div class="chart-container">
    <EChart OptionRaw="@_option" style="width:100%;height:100%;" />
</div>

@code {
    private string _option = @"{
        ""title"": { ""text"": ""Speed Gauge"" },
        ""tooltip"": { ""formatter"": ""{a} <br/>{b} : {c} km/h"" },
        ""series"": [{
            ""name"": ""Speed"",
            ""type"": ""gauge"",
            ""detail"": { ""formatter"": ""{value} km/h"" },
            ""data"": [{ ""value"": 72, ""name"": ""Current Speed"" }]
        }]
    }";
}
