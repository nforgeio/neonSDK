@page "/line"
@rendermode InteractiveServer

<PageTitle>Line Chart</PageTitle>

<h1>Line Chart</h1>
<p>A line chart with smooth curves and area fill.</p>

<div class="chart-container">
    <EChart OptionRaw="@_option" style="width:100%;height:100%;" />
</div>

@code {
    private string _option = @"{
        ""title"": { ""text"": ""Weekly Temperature"" },
        ""tooltip"": { ""trigger"": ""axis"" },
        ""legend"": { ""data"": [""High"", ""Low""] },
        ""xAxis"": { ""type"": ""category"", ""data"": [""Mon"", ""Tue"", ""Wed"", ""Thu"", ""Fri"", ""Sat"", ""Sun""] },
        ""yAxis"": { ""type"": ""value"", ""axisLabel"": { ""formatter"": ""{value} \u00b0C"" } },
        ""series"": [
            { ""name"": ""High"", ""type"": ""line"", ""smooth"": true, ""data"": [11, 11, 15, 13, 12, 13, 10] },
            { ""name"": ""Low"", ""type"": ""line"", ""smooth"": true, ""areaStyle"": {}, ""data"": [1, -2, 2, 5, 3, 2, 0] }
        ]
    }";
}
