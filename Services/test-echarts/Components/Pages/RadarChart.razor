@page "/radar"
@rendermode InteractiveServer

<PageTitle>Radar Chart</PageTitle>

<h1>Radar Chart</h1>
<p>A radar/spider chart comparing multiple dimensions.</p>

<div class="chart-container">
    <EChart OptionRaw="@_option" style="width:100%;height:100%;" />
</div>

@code {
    private string _option = @"{
        ""title"": { ""text"": ""Skill Comparison"" },
        ""tooltip"": {},
        ""legend"": { ""data"": [""Developer A"", ""Developer B""] },
        ""radar"": {
            ""indicator"": [
                { ""name"": ""Frontend"", ""max"": 100 },
                { ""name"": ""Backend"", ""max"": 100 },
                { ""name"": ""DevOps"", ""max"": 100 },
                { ""name"": ""Testing"", ""max"": 100 },
                { ""name"": ""Design"", ""max"": 100 },
                { ""name"": ""Communication"", ""max"": 100 }
            ]
        },
        ""series"": [{
            ""type"": ""radar"",
            ""data"": [
                { ""value"": [90, 70, 60, 80, 50, 85], ""name"": ""Developer A"" },
                { ""value"": [60, 95, 85, 70, 40, 70], ""name"": ""Developer B"" }
            ]
        }]
    }";
}
