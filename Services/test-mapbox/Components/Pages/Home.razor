@page "/"
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<PageTitle>Mapbox Demo - Home</PageTitle>

<div class="home-hero">
    <h1>Neon.Mapbox</h1>
    <p>Explore the <code>MapboxMap</code> Blazor component from Neon.Mapbox, powered by <a href="https://docs.mapbox.com/mapbox-gl-js/" target="_blank">Mapbox GL JS</a>. Each demo on the left shows a different feature: styling, camera animation, GeoJSON sources and layers, popups and events.</p>
</div>

@if (string.IsNullOrWhiteSpace(Configuration["Mapbox:AccessToken"]))
{
    <div class="token-gate">
        <h3>Mapbox access token required</h3>
        <p>The map tiles will not load until you supply a Mapbox access token. The recommended way is .NET user secrets — from the <code>Services/test-mapbox</code> directory run:</p>
        <p><code>dotnet user-secrets set "Mapbox:AccessToken" "pk.…"</code></p>
        <p>Alternatively set the environment variable <code>MAPBOX_ACCESS_TOKEN</code>.</p>
        <p>Get a free token at <a href="https://account.mapbox.com/access-tokens/" target="_blank">account.mapbox.com</a>.</p>
    </div>
}

