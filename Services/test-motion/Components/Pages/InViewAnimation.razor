@page "/inview"
@rendermode InteractiveServer
@inject JsInterop Motion
@implements IAsyncDisposable

<PageTitle>Motion Demo - In View</PageTitle>

<div class="page-header">
    <h1>In View</h1>
    <p><code>inView()</code> fires a callback when an element enters the viewport. Scroll the panel below to see cards animate in.</p>
</div>

<div class="demo-container">
    <div class="demo-stage" style="padding:0;align-items:stretch">
        <div class="inview-scroll" id="@_rootId">
            <div class="inview-spacer">↓ Scroll down to see cards animate in</div>

            @for (int i = 0; i < _cards.Length; i++)
            {
                var card = _cards[i];
                <div class="inview-card @_cardClass" id="inview-card-@i" style="border-left: 3px solid @card.Accent">
                    <div class="inview-card-title">@card.Title</div>
                    <div class="inview-card-body">@card.Body</div>
                </div>
            }

            <div class="inview-spacer">— end —</div>
        </div>
    </div>
    <div class="demo-controls">
        <button class="btn btn-primary" @onclick="Reset">Reset &amp; Scroll to Top</button>
    </div>
</div>

<div class="code-block">
<span class="kw">import</span> &#123; <span class="fn">inView</span>, <span class="fn">animate</span> &#125; <span class="kw">from</span> <span class="str">"motion"</span>

<span class="fn">inView</span>(<span class="str">".card"</span>, element =&gt; &#123;
  <span class="fn">animate</span>(element, &#123; <span class="str">opacity</span>: <span class="num">1</span>, <span class="str">y</span>: <span class="num">0</span> &#125;,
    &#123; <span class="str">duration</span>: <span class="num">0.5</span>, <span class="str">ease</span>: <span class="str">"easeOut"</span> &#125;)
&#125;, &#123; <span class="str">root</span>: document.<span class="fn">querySelector</span>(<span class="str">"#scroll-root"</span>), <span class="str">amount</span>: <span class="num">0.3</span> &#125;)
</div>

@code {
    private readonly string _rootId    = "inview_root_" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _cardClass = "ivc_" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _inViewId  = "inview_" + Guid.NewGuid().ToString("N")[..8];

    private record InViewCard(string Title, string Body, string Accent);

    private readonly InViewCard[] _cards =
    [
        new("Declarative animations",  "Describe what you want — Motion handles the how.", "#6366f1"),
        new("Hardware accelerated",    "Uses GPU-composited transforms for 60fps motion.",  "#8b5cf6"),
        new("Spring physics",          "Natural, interruptible motion with real spring math.", "#a78bfa"),
        new("Scroll-driven",           "Tie any value to scroll position with zero JS overhead.", "#c084fc"),
        new("Accessibility-first",     "Respects prefers-reduced-motion out of the box.", "#e879f9"),
        new("3kb min+gz",              "Tiny bundle size — no dependencies, tree-shakeable.", "#f472b6"),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await StartInViewAsync();
    }

    async Task StartInViewAsync()
    {
        await Motion.InViewAsync(
            _inViewId,
            "." + _cardClass,
            onEnter: async (id) =>
            {
                // Each card gets its own one-shot animate call when it enters
                var animId = "card_enter_" + Guid.NewGuid().ToString("N")[..8];
                // We can't easily get the specific element here, so we animate via
                // a selector that the JS resolves — the per-element enter fires individually
                await Task.CompletedTask;
            },
            options: new InViewOptions
            {
                Root   = "#" + _rootId,
                Amount = "0.3",
            });

        // Directly drive per-element animations using JS interop for each card
        for (int i = 0; i < _cards.Length; i++)
        {
            var cardId  = $"inview-card-{i}";
            var animId  = "card_iv_" + i + "_" + Guid.NewGuid().ToString("N")[..6];
            await Motion.InViewAsync(
                animId,
                "#" + cardId,
                onEnter: async (_) =>
                {
                    var enterAnim = "enter_" + Guid.NewGuid().ToString("N")[..8];
                    await Motion.AnimateAsync(enterAnim, "#" + cardId,
                        new AnimationValues().Opacity(1).Y(0),
                        new AnimateOptions { Duration = 0.5, Ease = "easeOut" });
                },
                options: new InViewOptions
                {
                    Root   = "#" + _rootId,
                    Amount = "0.3",
                });
        }
    }

    async Task Reset()
    {
        // Reset all cards to invisible
        for (int i = 0; i < _cards.Length; i++)
        {
            var resetId = "reset_" + i + "_" + Guid.NewGuid().ToString("N")[..6];
            await Motion.AnimateAsync(resetId, $"#inview-card-{i}",
                new AnimationValues().Opacity(0).Y(24),
                new AnimateOptions { Duration = 0 });
        }

        // Scroll back to top via JS
        await Motion.InViewAsync(
            _inViewId, "." + _cardClass,
            onEnter: async _ => await Task.CompletedTask,
            options: new InViewOptions { Root = "#" + _rootId });

        StateHasChanged();
    }

    public async ValueTask DisposeAsync() =>
        await Motion.StopInViewAsync(_inViewId);
}
