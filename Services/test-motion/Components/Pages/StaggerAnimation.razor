@page "/stagger"
@rendermode InteractiveServer
@inject JsInterop Motion

<PageTitle>Motion Demo - Stagger</PageTitle>

<div class="page-header">
    <h1>Stagger</h1>
    <p>The <code>stagger()</code> helper creates an offset delay between each element in a group, so they animate in sequence rather than all at once.</p>
</div>

<div class="demo-container">
    <div class="demo-stage" style="align-items:stretch;padding:1.5rem 2rem">
        <ul class="stagger-list" id="stagger-list-@_listId">
            @foreach (var item in _items)
            {
                <li class="stagger-item @_listId">
                    <span class="stagger-item-dot" style="background:@item.Color"></span>
                    <span class="stagger-item-text">@item.Label</span>
                </li>
            }
        </ul>
    </div>
    <div class="demo-controls">
        <button class="btn btn-primary" @onclick="PlayStagger">Play Stagger</button>
        <button class="btn btn-ghost" @onclick="Reset">Reset</button>
        <span class="demo-controls-label" style="margin-left:0.5rem">Interval:</span>
        <button class="btn btn-ghost btn-sm @(_interval == 0.05 ? "btn-primary" : "")" @onclick='() => _interval = 0.05'>Fast</button>
        <button class="btn btn-ghost btn-sm @(_interval == 0.12 ? "btn-primary" : "")" @onclick='() => _interval = 0.12'>Medium</button>
        <button class="btn btn-ghost btn-sm @(_interval == 0.25 ? "btn-primary" : "")" @onclick='() => _interval = 0.25'>Slow</button>
    </div>
</div>

<div class="code-block">
<span class="kw">import</span> &#123; <span class="fn">animate</span>, <span class="fn">stagger</span> &#125; <span class="kw">from</span> <span class="str">"motion"</span>

<span class="fn">animate</span>(
  <span class="str">"li"</span>,
  &#123; <span class="str">opacity</span>: <span class="num">1</span>, <span class="str">y</span>: <span class="num">0</span> &#125;,
  &#123; <span class="str">delay</span>: <span class="fn">stagger</span>(<span class="num">0.1</span>), <span class="str">duration</span>: <span class="num">0.4</span>, <span class="str">ease</span>: <span class="str">"easeOut"</span> &#125;
)
</div>

@code {
    private string _listId = Guid.NewGuid().ToString("N")[..8];
    private double _interval = 0.12;

    private record DemoItem(string Label, string Color);

    private readonly DemoItem[] _items =
    [
        new("Design system tokens",   "#6366f1"),
        new("Component architecture", "#8b5cf6"),
        new("Animation library",      "#a78bfa"),
        new("Accessibility audit",    "#c4b5fd"),
        new("Performance review",     "#ddd6fe"),
    ];

    async Task PlayStagger()
    {
        var animId = "stagger_" + Guid.NewGuid().ToString("N");

        await Motion.AnimateStaggerAsync(
            animId,
            "." + _listId,
            new AnimationValues().Opacity(1).Y(0),
            _interval,
            new AnimateOptions { Duration = 0.4, Ease = "easeOut" });
    }

    async Task Reset()
    {
        var animId = "reset_" + Guid.NewGuid().ToString("N");

        await Motion.AnimateAsync(
            animId,
            "." + _listId,
            new AnimationValues().Opacity(0).Y(16),
            new AnimateOptions { Duration = 0.2 });
    }
}
